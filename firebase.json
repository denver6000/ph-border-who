{
  "auth": {
    "providers": {
      "anonymous": true,
      "emailPassword": true
    }
  },
  "apphosting": {
    "backendId": "hdx-baranggay-boundary",
    "rootDir": "/",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "functions"
    ]
  },
  "firestore": {
    "database": "(default)",
    "location": "asia-southeast1",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
